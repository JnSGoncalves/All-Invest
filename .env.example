# Variáveis lidas pelo docker-compose (raiz do projeto).
# Para as credenciais do backend, copie também backend/.env.example para
# backend/.env. O docker-compose carrega o banco e os segredos desse arquivo.

# Frontend (incorporadas durante o build da imagem).
VITE_API_URL=http://localhost:4670
VITE_API_KEY=your-api-key-from-api_keys-table

# URLs públicas do fluxo OAuth e CORS para o Docker local.
GOOGLE_REDIRECT_URI=http://localhost:4670/api/v1/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:4671/auth/callback
CORS_ORIGINS=http://localhost:4671
ENVIRONMENT=development

# Backend. Necessárias ao executar a API diretamente a partir da raiz.
# Com Docker, copie estas variáveis para backend/.env, pois esse é o arquivo
# carregado pelo serviço backend.
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DATABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com
BRAPI_TOKEN=your-brapi-token
BRAPI_URL=https://brapi.dev/api/v2

SECRET_KEY=gere-uma-chave-aleatoria-longa
SESSION_SECRET_KEY=gere-outra-chave-aleatoria-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
# CLIENT_ID e CLIENT_SECRET são aliases legados opcionais do Google OAuth.
# CLIENT_ID=
# CLIENT_SECRET=
