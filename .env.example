# Backend Environment Variables - Create a .env file in the backend directory and set the following variables
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# Frontend Environment Variables - create a .env file in the frontend directory and set the following variables
VITE_API_URL=https://api.yourdomain.url/
VITE_API_KEY=your_api_key_here