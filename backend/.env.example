# Obrigatória. Connection string PostgreSQL do Supabase; mantenha sslmode=require.
DATABASE_URL=postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# Opcional. Use o Session pooler em redes sem IPv6; deixe vazio para a conexão direta.
# Use o Session pooler quando o ambiente não tiver conectividade IPv6.
# O host exato é fornecido em Supabase > Connect > Session pooler.
# DATABASE_POOLER_HOST=aws-0-<region>.pooler.supabase.com

# Obrigatória para endpoints que validam ticker/cotação (POST /api/stocks).
BRAPI_TOKEN=your-brapi-token
# Opcional; o padrão usado pelo backend é https://brapi.dev/api/v2.
BRAPI_URL=https://brapi.dev/api/v2

# JWT da aplicação e cookie temporário usado durante OAuth. Em produção, ambas
# devem ser chaves aleatórias, longas e diferentes.
SECRET_KEY=gere-uma-chave-aleatoria-longa
SESSION_SECRET_KEY=gere-outra-chave-aleatoria-longa

# development (padrão) ou production. Em produção SECRET_KEY é obrigatória e
# o cookie OAuth é enviado somente por HTTPS.
ENVIRONMENT=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Lista separada por vírgulas de origens autorizadas pelo CORS.
CORS_ORIGINS=http://localhost:5173,http://localhost:4671,https://allinvest.ojota.dev.br

# Credenciais do cliente Web criado no Google Cloud Console.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret
# Aliases legados aceitos somente se GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET não
# estiverem configurados: CLIENT_ID e CLIENT_SECRET.
# CLIENT_ID=
# CLIENT_SECRET=

# Deve ser idêntica à URI autorizada no Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Opcional: após autenticar, redireciona para o frontend com o JWT no fragmento (#).
# Sem esta variável, o callback responde o JWT como JSON.
# Desenvolvimento: http://localhost:5173/auth/callback
# Produção: https://allinvest.ojota.dev.br/auth/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:5173/auth/callback
